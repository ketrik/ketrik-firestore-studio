// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"label": "watch",
			"isBackground": true,
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "relative",
				"pattern": [
					{
						"regexp": "^(?:✘ \\[ERROR\\]|▲ \\[WARNING\\]) (.*)$",
						"message": 1
					},
					{
						"regexp": "^$"
					},
					{
						"regexp": "^\\s+([^:]+):(\\d+):(\\d+):$",
						"file": 1,
						"line": 2,
						"column": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": {
						"regexp": "^\\[watch\\] build started"
					},
					"endsPattern": {
						"regexp": "^\\[watch\\] build finished"
					}
				}
			},
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}